# Deploy settings for the scripts in deploy/. Copy this file to .env and edit it:
#   cp .env.example .env
# Every line is optional. Uncomment one to change it; the value shown is the default.
# A variable already set in the shell wins over .env (ZONE=... deploy/gce-up.sh).
# The loader keeps the FIRST value of a key: to change a key that already has a
# line, edit that line (a second one appended below is ignored). Keep the newline
# at the end of the file, or `echo KEY=value >> .env` glues onto the last line.
# No secrets here: the remote password lives on the server, not in this file.

# ── Google Cloud ──
# Your project. Empty = the active gcloud project (gcloud config set project ...).
#PROJECT_ID=
# europe-west1 (Belgium): cheap, about 60 ms from Israel.
#REGION=europe-west1
# Zone for the VM. If a zone is out of e2-small, try europe-west1-c.
#ZONE=europe-west1-b

# ── The VM (deploy/gce-*.sh) ──
# Your own hostname (an A record pointing at the static IP). Empty = <ip-with-dashes>.sslip.io.
#DOMAIN=
# E-mail for Let's Encrypt expiry notices. Empty is fine.
#ACME_EMAIL=
# Name of the VM.
#INSTANCE=party-arena
# Machine size. e2-small is plenty for 40 phones.
#MACHINE_TYPE=e2-small
# Boot image and disk.
#IMAGE_FAMILY=debian-12
#IMAGE_PROJECT=debian-cloud
#BOOT_DISK_SIZE=10GB
# Network, firewall tag, static IP and firewall rule names.
#NETWORK=default
#NETWORK_TAG=party-arena-web
#IP_NAME=party-arena-ip
#FW_WEB=party-arena-allow-web
#FW_SSH=party-arena-allow-ssh
# Node major version installed on the VM.
#NODE_MAJOR=22
# Port the Node server listens on inside the VM (Caddy proxies 443 to it).
#APP_PORT=8080
# Seconds gce-deploy.sh waits for https://<host>/healthz (the first boot issues the certificate).
#HEALTH_TIMEOUT=420

# ── Cloud Run (deploy/cloudrun-*.sh) ──
#SERVICE=party-arena
#RUN_MEMORY=1Gi
#RUN_CPU=1
#RUN_CONCURRENCY=1000
#RUN_TIMEOUT=3600

# ── Firebase Hosting (deploy/firebase-deploy.sh) ──
# Firebase project. Empty = PROJECT_ID.
#FIREBASE_PROJECT=
# Which server the Firebase-hosted client talks to: auto | gce | cloudrun | an https:// URL.
#FIREBASE_BACKEND=auto
#FIREBASE_TOOLS_VERSION=latest

# ── Build switches (reach every deploy path) ──
# Force the address in the TV's QR code, e.g. https://party.example.com. Empty = worked out on the TV.
#VITE_PUBLIC_URL=
