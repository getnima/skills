{
  "hosting": {
    "public": "dist/client",
    "ignore": ["firebase.json", "**/.*", "**/README.md", "**/node_modules/**", "**/*.br", "**/*.gz"],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/host", "destination": "/host.html" },
      { "source": "/remote", "destination": "/remote.html" },
      { "source": "/show", "destination": "/show.html" },
      { "source": "/dev", "destination": "/dev.html" }
    ],
    "headers": [
      {
        "source": "/assets/*.@(js|css|map)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/assets/*/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/@(audio|cutscenes|icons)/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(html|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/@(host|remote|show|dev)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
